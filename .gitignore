# Directorio de descarga automática de Maven (se crea la primera vez que ejecutas los scripts)
.tools/

# Carpeta de compilación de Java (se descarta al clonar el repositorio o hacer clean)
target/

# Archivos JSONL generados durante la ejecución de pruebas con participantes reales (solo después de la primera corrida)
dados/pruebas.jsonl
dados/participantes.jsonl

# Fichero de registro de pruebas técnicas (creado durante el desarrollo/debugging)
evidencias/registro-pruebas-tecnicas.csv